{
  "name": "catalyst",
  "displayName": "Catalyst",
  "description": "Real-time secondary display workspace",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TirthBora/Catalyst.git"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "catalyst.openUI",
        "title": "Catalyst: Open Workspace"
      }
    ],
    "configuration": {
      "title": "Catalyst",
      "properties": {
        "catalyst.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the Catalyst daemon executable (catalyst.exe)."
        },
        "catalyst.port": {
          "type": "string",
          "default": "9999",
          "description": "Port on which Catalyst exposes the second-screen workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "package:vsix": "npx --yes @vscode/vsce package --no-git-tag-version",
    "build:daemon": "go build -o bin/catalyst.exe ./cmd/catalyst",
    "build:all": "go run ./scripts/build.go",
    "test:go": "go test -count=1 -v ./...",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
